"только"],"en":[],"sources":["ruwikt"]},"цѣлитисѧ":{"ru":["лечиться","врачеваться"],"en":[],"sources":["ruwikt"],"examples":[{"cu":"Прохожда́ше же па́че сло́во ѡ҆ не́мъ: и҆ схожда́хꙋсѧ наро́ди мно́зи слы́шати и҆ цѣли́тисѧ ѿ негѡ̀ ѿ недꙋ̑гъ свои́хъ.","ru":"Но тем более распространялась молва о Нём, и великое множество народа стекалось к Нему слушать и врачеваться у Него от болезней своих."}]},"цѣлыи":{"ru":["целый","здоровый"],"en":[],"sources":["ruwikt"],"examples":[{"cu":"бы́сть же и҆̀мъ лѣ́то цѣ́ло собира́тисѧ въ цр҃кви и҆ ѹ҆чи́ти наро́дъ мно́гъ, нарещи́ же пре́жде во а҆нтїохі́и ѹ҆чн҃кѝ хрⷭ҇тїа́ны.","ru":"Целый год собирались они в церкви и учили немалое число людей, и ученики в Антиохии в первый раз стали называться Христианами."},{"cu":"И҆ воззрѣ́въ на ни́хъ со гнѣ́вомъ, скорбѧ̀ ѡ҆ ѡ҆камене́нїи серде́цъ и҆́хъ, гл҃а человѣ́кꙋ: прострѝ рꙋ́кꙋ твою̀. И҆ прострѐ: и҆ ѹ҆тверди́сѧ рꙋка̀ є҆гѡ̀ цѣла̀ ꙗ҆́кѡ дрꙋга́ѧ.","ru":"И, воззрев на них с гневом, скорбя об ожесточении сердец их, говорит тому человеку: протяни руку твою. Он протянул, и стала рука его здорова, как другая."}]},"цѣнитисѧ":{"ru":["продаваться"],"en":[],"sources":["ruwikt"],"examples":[{"cu":"Не пѧ́ть ли пти́цъ цѣни́тсѧ пѣ́нѧзема двѣма̀, и҆ ни є҆ди́на ѿ ни́хъ нѣ́сть забве́на пред̾ бг҃омъ.","ru":"Не пять ли малых птиц продаются за два ассария? и ни одна из них не забыта у Бога."}]},"церковь":{"ru":["собрание","храм"],"en":[],"sources":["ruwikt"],"examples":[{"cu":"И҆ вни́де во і҆ерⷭ҇ли́мъ і҆и҃съ и҆ въ це́рковь: и҆ соглѧ́давъ всѧ̑, по́здѣ ѹ҆жѐ сꙋ́щꙋ часꙋ̀, и҆зы́де въ виѳа́нїю со ѻ҆бѣмана́десѧте.","ru":"И вошел Иисус в Иерусалим и в храм; и, осмотрев всё, как время уже было позднее, вышел в Вифанию с двенадцатью."}]},"церковныи":{"ru":["церковный"],"en":[],"sources":["ruwikt"]},"цьркꙑ#orv":{"ru":["храм вообще"],"en":[],"sources":["ruwikt","syntacticus"],"forms":["цркви","церкви","црькви","цкрвамъ","црквам","црквамъ","церквеи","церквии","црквии","црквіи","црквахъ","црквах","црквхъ","црки","цркъви","церковь","црв